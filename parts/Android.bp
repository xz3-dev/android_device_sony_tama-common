android_app {
    name: "XperiaParts",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "org.lineageos.platform.internal",
    ],

    required: [
        "default-permissions_org.lineageos.xperiaparts.xml",
    ],

    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "default-permissions_org.lineageos.xperiaparts.xml",
    src: "default-permissions_org.lineageos.xperiaparts.xml",
    sub_dir: "default-permissions",
    system_ext_specific: true,
}
